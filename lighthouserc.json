{
  "ci": {
    "collect": {
      "startServerCommand": "npm start -- --port 3220",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3220/en", "http://localhost:3220/en/execution", "http://localhost:3220/en/systems"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 4000, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 500, "aggregationMethod": "median" }],
        "total-byte-weight": ["error", { "maxNumericValue": 820000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
