RewriteEngine On

# Sito spostato su Vercel: redirect permanente di ogni richiesta, conservando il percorso.
# I vecchi URL (/index.php, /error, /projDev/*, /projProd/*) sono poi gestiti dalle redirect di next.config.ts.
# Sostituire <progetto>.vercel.app con l'URL di produzione prima di caricare il file nella root Altervista.
RewriteRule ^(.*)$ https://<progetto>.vercel.app/$1 [R=301,L]
